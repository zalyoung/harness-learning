{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "description", "upvote", "reviews_star", "website_url"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "upvote": {
        "type": "integer",
        "minimum": 0
      },
      "reviews_star": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      },
      "website_url": {
        "type": "string",
        "format": "uri"
      }
    },
    "additionalProperties": false
  },
  "minItems": 1,
  "maxItems": 10
}
